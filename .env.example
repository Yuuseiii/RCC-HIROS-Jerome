# RCC-HIROS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# ── Local development (XAMPP MariaDB) ──────────────────────────
DATABASE_URL="mysql://root:@localhost:3306/rcc_hiros"

# ── docker-compose ─────────────────────────────────────────────
# Root password for the MariaDB container (the compose stack reads this).
# If you already have data in local XAMPP, set this to the same password
# you use for MySQL root so both environments stay consistent.
DB_ROOT_PASSWORD="change-me-strong-password"

# Strong random secret for JWT signing (required)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-random-secret"

# ── Cloudflare Tunnel (optional) ───────────────────────────────
# Leave empty to use an anonymous quick tunnel (random *.trycloudflare.com URL).
# Paste a named-tunnel token from the Cloudflare Zero Trust dashboard for a
# stable, permanent hostname (recommended for submission).
TUNNEL_TOKEN=""

# ── ZK Kiosk Fingerprint Service (loopback HTTP, not WebSocket) ─
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"
